# General settings
BASE_URL=https://planka.example.com
# Domain for Caddy reverse proxy
PLANKA_DOMAIN=planka.example.com
# Email for Let's Encrypt certificate notifications
PLANKA_TLS_EMAIL=admin@example.com
PORT=1337
TRUST_PROXY=1
APP_TIMEZONE=Europe/Moscow
SECRET_KEY=change_me_to_a_random_64_char_string

# Default admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=please_change_me
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator

# PostgreSQL configuration
POSTGRES_DB=planka
POSTGRES_USER=planka
POSTGRES_PASSWORD=please_change_me

# Email (SMTP) configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=true
SMTP_FROM=Planka <noreply@planka.example.com>

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
